# ==========================================
# Argus Code Backend Environment Settings
# ==========================================

# OpenAI API Configuration (Optional if using Gemini or Heuristic analyzer)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL_NAME=gpt-4o-mini

# Google Gemini API Configuration (Optional if using OpenAI or Heuristic analyzer)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-1.5-pro

# Provider selection: "auto", "openai", "gemini", or "heuristic"
MODEL_PROVIDER=auto

# Server Configuration
PORT=8000
APP_ENV=development
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]
